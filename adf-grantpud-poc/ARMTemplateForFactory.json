						"type": "string",
						"defaultValue": "BPAT"
					},
					"stationId": {
						"type": "string",
						"defaultValue": "GHCND:USW00024229"
					}
				},
				"variables": {
					"dateArray": {
						"type": "Array"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-05-26T16:18:48Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/pl_bronze_ingest_daily')]"
			]
		},
