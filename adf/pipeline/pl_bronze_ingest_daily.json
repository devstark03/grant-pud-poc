						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-grantpud-poc.vault.azure.net/secrets/eia-api-key?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Get_NOAA_Token",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get_EIA_ApiKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-grantpud-poc.vault.azure.net/secrets/noaa-token?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Copy_EIA_to_Bronze",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Get_NOAA_Token",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings",
							"filePattern": "setOfObjects"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_rest_eia_regiondata",
						"type": "DatasetReference",
						"parameters": {
							"apiKey": {
								"value": "@activity('Get_EIA_ApiKey').output.value",
								"type": "Expression"
							},
							"startDate": {
								"value": "@concat(pipeline().parameters.runDate, 'T00')",
								"type": "Expression"
							},
							"endDate": {
								"value": "@concat(pipeline().parameters.runDate, 'T23')",
								"type": "Expression"
							},
							"respondent": {
								"value": "@pipeline().parameters.respondent",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_bronze_eia",
						"type": "DatasetReference",
						"parameters": {
							"respondent": {
								"value": "@pipeline().parameters.respondent",
								"type": "Expression"
							},
							"year": {
								"value": "@substring(pipeline().parameters.runDate, 0, 4)",
								"type": "Expression"
							},
							"month": {
								"value": "@substring(pipeline().parameters.runDate, 5, 2)",
								"type": "Expression"
							},
							"day": {
								"value": "@substring(pipeline().parameters.runDate, 8, 2)",
								"type": "Expression"
							}
						}
					}
				]
