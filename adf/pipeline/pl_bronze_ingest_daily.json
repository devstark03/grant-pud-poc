				"inputs": [
					{
						"referenceName": "ds_rest_noaa_observations",
						"type": "DatasetReference",
						"parameters": {
							"token": {
								"value": "@activity('Get_NOAA_Token').output.value",
								"type": "Expression"
							},
							"stationId": {
								"value": "@pipeline().parameters.stationId",
								"type": "Expression"
							},
							"startDate": {
								"value": "@pipeline().parameters.runDate",
								"type": "Expression"
							},
							"endDate": {
								"value": "@pipeline().parameters.runDate",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_bronze_noaa",
						"type": "DatasetReference",
						"parameters": {
							"stationId": {
								"value": "@pipeline().parameters.stationId",
								"type": "Expression"
							},
							"year": {
								"value": "@substring(pipeline().parameters.runDate, 0, 4)",
								"type": "Expression"
