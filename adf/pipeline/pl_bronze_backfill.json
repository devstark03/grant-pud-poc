{
	"name": "pl_bronze_backfill",
	"properties": {
		"description": "One-time backfill wrapper that loops a date range and invokes pl_bronze_ingest_daily for each date",
		"activities": [
			{
				"name": "Append_Date",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0, pipeline().parameters.daysToGet)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "dateArray",
								"value": {
									"value": "@formatDateTime(addDays(pipeline().parameters.startDate, item()), 'yyyy-MM-dd')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "ForEach_Date",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Append_Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('dateArray')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Execute Pipeline1",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_bronze_ingest_daily",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"runDate": {
										"value": "@item()",
										"type": "Expression"
									},
									"respondent": {
										"value": "@pipeline().parameters.respondent",
										"type": "Expression"
									},
									"stationId": {
										"value": "@pipeline().parameters.stationId",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"startDate": {
				"type": "string",
				"defaultValue": "2026-04-01"
			},
			"daysToGet": {
				"type": "int",
				"defaultValue": 60
			},
			"respondent": {
				"type": "string",
				"defaultValue": "BPAT"
			},
			"stationId": {
				"type": "string",
				"defaultValue": "GHCND:USW00024229"
			}
		},
		"variables": {
			"dateArray": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-05-26T16:18:48Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}