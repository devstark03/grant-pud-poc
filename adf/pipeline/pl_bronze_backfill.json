{
	"name": "pl_bronze_backfill",
	"properties": {
		"description": "One-time backfill wrapper that loops a date range and invokes pl_bronze_ingest_daily for each date",
		"activities": [
			{
				"name": "Append_Date",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(0, pipeline().parameters.daysToGet)",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Append variable1",
							"type": "AppendVariable",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"variableName": "dateArray",
								"value": {
									"value": "@formatDateTime(addDays(pipeline().parameters.startDate, item()), 'yyyy-MM-dd')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "ForEach_Date",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Append_Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('dateArray')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Execute Pipeline1",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_bronze_ingest_daily",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"runDate": {
										"value": "@item()",
										"type": "Expression"
									},
									"respondent": {
										"value": "@pipeline().parameters.respondent",
										"type": "Expression"
									},
									"stationId": {
										"value": "@pipeline().parameters.stationId",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Notify_PipelineSucceeded",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "ForEach_Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://app-grantpud-poc-monitor-ezfxdeg7atcreygg.canadaeast-01.azurewebsites.net/api/runs/notify",
					"body": {
						"value": "@json(concat(\n'{',\n'\"pipelineRunId\":\"', pipeline().RunId, '\",',\n'\"pipelineName\":\"', pipeline().Pipeline, '\",',\n'\"dataFactoryName\":\"', pipeline().DataFactory, '\",',\n'\"status\":\"Succeeded\",',\n'\"startTime\":\"', pipeline().TriggerTime, '\",',\n'\"endTime\":\"', utcnow(), '\",',\n'\"errorMessage\":null,',\n'\"notificationId\":\"', pipeline().RunId, '-succeeded\"',\n'}'\n))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Notify_PipelineFailed",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "ForEach_Date",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "Append_Date",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://app-grantpud-poc-monitor-ezfxdeg7atcreygg.canadaeast-01.azurewebsites.net/api/runs/notify",
					"body": {
						"value": "@json(concat(\n'{',\n'\"pipelineRunId\":\"', pipeline().RunId, '\",',\n'\"pipelineName\":\"', pipeline().Pipeline, '\",',\n'\"dataFactoryName\":\"', pipeline().DataFactory, '\",',\n'\"status\":\"Failed\",',\n'\"startTime\":\"', pipeline().TriggerTime, '\",',\n'\"endTime\":\"', utcnow(), '\",',\n'\"errorMessage\":\"Pipeline activity failed. Check ADF Monitor for details.\",',\n'\"notificationId\":\"', pipeline().RunId, '-failed\"',\n'}'\n))",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"startDate": {
				"type": "string",
				"defaultValue": "2026-04-01"
			},
			"daysToGet": {
				"type": "int",
				"defaultValue": 60
			},
			"respondent": {
				"type": "string",
				"defaultValue": "BPAT"
			},
			"stationId": {
				"type": "string",
				"defaultValue": "GHCND:USW00024229"
			}
		},
		"variables": {
			"dateArray": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-05-26T16:18:48Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}